{
    "name": "meeting-transcript-public-chatbot",
    "description": "The public chatbot's guardrail: prompt attacks, harmful content, off-limits topics, and sensitive numbers masked in replies.",
    "contentPolicyConfig": {
        "filtersConfig": [
            { "type": "PROMPT_ATTACK", "inputStrength": "HIGH", "outputStrength": "NONE" },
            { "type": "HATE", "inputStrength": "HIGH", "outputStrength": "MEDIUM" },
            { "type": "INSULTS", "inputStrength": "HIGH", "outputStrength": "MEDIUM" },
            { "type": "SEXUAL", "inputStrength": "HIGH", "outputStrength": "MEDIUM" },
            { "type": "VIOLENCE", "inputStrength": "HIGH", "outputStrength": "MEDIUM" },
            { "type": "MISCONDUCT", "inputStrength": "HIGH", "outputStrength": "MEDIUM" }
        ]
    },
    "topicPolicyConfig": {
        "topicsConfig": [
            {
                "name": "Voting advice and political opinions",
                "definition": "Asking how to vote, which candidate, party or ballot measure to support, or for the assistant's own opinion of officials or decisions. Not questions about what was said or decided.",
                "examples": [
                    "Who should I vote for in the council election?",
                    "Should I support the parks bond measure?",
                    "Is the mayor doing a good job?",
                    "Which council member is the best?"
                ],
                "type": "DENY",
                "inputEnabled": true,
                "inputAction": "BLOCK",
                "outputEnabled": false,
                "outputAction": "NONE"
            },
            {
                "name": "Legal advice",
                "definition": "Asking for advice on the asker's own legal situation: their rights, whether to sue or appeal, or how to fight a fine or ruling. Not questions about what a meeting or case said.",
                "examples": [
                    "Can I sue the city over my parking ticket?",
                    "Do I need a lawyer for my zoning appeal?",
                    "How do I get out of the fine the council approved?"
                ],
                "type": "DENY",
                "inputEnabled": true,
                "inputAction": "BLOCK",
                "outputEnabled": false,
                "outputAction": "NONE"
            }
        ]
    },
    "sensitiveInformationPolicyConfig": {
        "piiEntitiesConfig": [
            { "type": "US_SOCIAL_SECURITY_NUMBER", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "US_INDIVIDUAL_TAX_IDENTIFICATION_NUMBER", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "US_PASSPORT_NUMBER", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "DRIVER_ID", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "CREDIT_DEBIT_CARD_NUMBER", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "CREDIT_DEBIT_CARD_CVV", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "CREDIT_DEBIT_CARD_EXPIRY", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "US_BANK_ACCOUNT_NUMBER", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "US_BANK_ROUTING_NUMBER", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "INTERNATIONAL_BANK_ACCOUNT_NUMBER", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "PIN", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" },
            { "type": "PHONE", "action": "ANONYMIZE", "inputAction": "NONE", "outputAction": "ANONYMIZE" }
        ]
    },
    "blockedInputMessaging": "I can only help with questions about the archive's public meetings. Try asking about a meeting, a council or board, or something that was discussed.",
    "blockedOutputsMessaging": "Sorry, I can't give that answer. Try asking about a specific meeting or topic in the archive."
}
