{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3TicketBucket",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::lg-transcription-bucket/uploads/*",
                "arn:aws:s3:::lg-transcription-bucket/audio/*",
                "arn:aws:s3:::lg-transcription-bucket/transcripts/*"
            ]
        },
        {
            "Sid": "MoveAndCleanUpUploads",
            "Effect": "Allow",
            "Action": [
                "s3:DeleteObject",
                "s3:GetObjectTagging"
            ],
            "Resource": [
                "arn:aws:s3:::lg-transcription-bucket/uploads/*",
                "arn:aws:s3:::lg-transcription-bucket/audio/*"
            ]
        },
        {
            "Sid": "S3MissingObjectsReturn404",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::lg-transcription-bucket"
        },
        {
            "Sid": "ManagedAiServicesNoResourceLevelSupport",
            "Effect": "Allow",
            "Action": [
                "comprehend:DetectKeyPhrases",
                "comprehend:DetectEntities",
                "transcribe:StartTranscriptionJob",
                "transcribe:GetTranscriptionJob",
                "transcribe:DeleteTranscriptionJob"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ReadDevDatabasePassword",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue",
                "secretsmanager:DescribeSecret"
            ],
            "Resource": "arn:aws:secretsmanager:us-east-1:397345411365:secret:TranscriptionDBSecret-*"
        },
        {
            "Sid": "SeeDatabaseStatus",
            "Effect": "Allow",
            "Action": [
                "rds:DescribeDBClusters",
                "rds:DescribeDBInstances",
                "rds:DescribeDBEngineVersions"
            ],
            "Resource": "*"
        }
    ]
}
