{
  "name": "TranscriptAgent",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "agent",
      "build": "CodeZip",
      "modelProvider": "Bedrock",
      "entrypoint": "main.py",
      "codeLocation": "app/agent",
      "runtimeVersion": "PYTHON_3_14",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "DATABASE_SECRET_ID",
          "value": "TranscriptionDBSecret"
        },
        {
          "name": "MEETING_BUCKET_NAME",
          "value": "lg-transcription-bucket"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        }
      ],
      "additionalPolicies": [
        "arn:aws:iam::397345411365:policy/meeting-transcript-archive"
      ]
    }
  ],
  "memories": [
    {
      "name": "agentMemory",
      "eventExpiryDuration": 30,
      "strategies": []
    }
  ]
}
